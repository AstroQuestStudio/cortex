/target

# Local, personal files (never committed)
/.claude/
/infra/
/docs-all.txt
/docs-sites.txt
/docs-stack.txt
/docs-stack-2.txt

# Public benchmark: fetched repositories, their atlases, per-run JSON
/bench/public/.repos/
/bench/public/.cortex-home/
/bench/public/results/*.json

# npm package: downloaded binary
/npm/vendor/

# Agents' working files, graph dumps, build logs (never published)
/_agents/
/graphify-out/
/build

# Public benchmark: second isolated home used by the lac run
/bench/public/.cortex-home-lac/

# Benchmark results: only the peek benchmark's own (public fixtures) is versioned
/bench/resultats/*
!/bench/resultats/agent-peek-*.json

# Agent-peek benchmark: large logs are generated by bench/agent-peek/gen.mjs, not versioned
/bench/agent-peek/fixtures/gros-*.log
/bench/agent-peek/fixtures/vert-*.log

# Cortex Web benchmark: isolated stores and downloaded pages (third-party documentation is not redistributed)
/bench/web/home*/
/bench/web/corpus-telecharge/
/bench/web/.cache/
